COWORKER_MASTER_KEY=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
GATEWAY_DB_PASSWORD=
COWORKER_DATA_DIR=/var/lib/coworker-llm/gateway
GATEWAY_DB_DIR=/var/lib/coworker-llm/postgres
MODEL_CONFIG_FILE=/var/lib/coworker-llm/models.yaml
MODEL_ENV_FILE=/var/lib/coworker-llm/models.env

# 此文件配置网关服务本身。模型供应商配置使用 providers.example.env，
# 通过 MODEL_TEMPLATE 选择官方模板后填写 MODEL_NAME 和私密Key；
# node dist/engine-config.js /private/provider.env /private/models.yaml /private/models.env
# MODEL_CONFIG_FILE与MODEL_ENV_FILE分别指向生成的两个文件。
